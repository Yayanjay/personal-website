da92642c-8234-4c16-8f84-74b1b8288ef1.svc.dalang.io {
    root * /var/www/personal-website

    file_server

    # Handle Vue Router history mode - fallback to index.html
    try_files {path} /index.html

    # Enable compression
    encode gzip zstd

    # Cache static assets aggressively (Vite adds content hashes to filenames)
    @static {
        path *.js *.css *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.pdf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Never cache index.html so new deploys take effect immediately
    @html {
        path *.html /
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}
